# Central network configuration.
# Loaded by every script (`set -a; source .env; set +a`) and by docker compose
# (--env-file). Names and ports here must match ARCHITECTURE.md.

# ------------------------------------------------------------------ versions
FABRIC_VERSION=2.5.16
FABRIC_CA_VERSION=1.5.22
COUCHDB_VERSION=3.3.3

# Docker image tags
IMAGE_TAG=2.5.16
CA_IMAGE_TAG=1.5.22

# ------------------------------------------------------------------ naming
DOMAIN=pdasp.com
COMPOSE_PROJECT_NAME=pdasp
DOCKER_NETWORK=pdasp_net

ORG1_MSP=Org1MSP
ORG2_MSP=Org2MSP
ORG3_MSP=Org3MSP
ORDERER_MSP=OrdererMSP

CHANNEL1=channel1
CHANNEL2=channel2

CHAINCODE_NAME=trade
CHAINCODE_VERSION=1.0
CHAINCODE_PATH=../chaincode/trade
CHAINCODE_LANG=golang
ENDORSEMENT_POLICY="OutOf(2,'Org1MSP.peer','Org2MSP.peer','Org3MSP.peer')"

# ------------------------------------------------------------------ ports: Fabric CA
CA_ORG1_PORT=7054
CA_ORG2_PORT=8054
CA_ORG3_PORT=9054
CA_ORDERER_PORT=10054

CA_ORG1_OPS_PORT=17054
CA_ORG2_OPS_PORT=18054
CA_ORG3_OPS_PORT=19054
CA_ORDERER_OPS_PORT=20054

# ------------------------------------------------------------------ ports: orderers
ORDERER1_PORT=7050
ORDERER1_ADMIN_PORT=7053
ORDERER1_OPS_PORT=9440

ORDERER2_PORT=7060
ORDERER2_ADMIN_PORT=7063
ORDERER2_OPS_PORT=9441

ORDERER3_PORT=7070
ORDERER3_ADMIN_PORT=7073
ORDERER3_OPS_PORT=9442

# ------------------------------------------------------------------ ports: peers
PEER0_ORG1_PORT=7051
PEER1_ORG1_PORT=7151
PEER2_ORG1_PORT=7251
PEER0_ORG2_PORT=8051
PEER1_ORG2_PORT=8151
PEER2_ORG2_PORT=8251
PEER0_ORG3_PORT=9051
PEER1_ORG3_PORT=9151
PEER2_ORG3_PORT=9251

PEER0_ORG1_OPS_PORT=9451
PEER1_ORG1_OPS_PORT=9452
PEER2_ORG1_OPS_PORT=9453
PEER0_ORG2_OPS_PORT=9454
PEER1_ORG2_OPS_PORT=9455
PEER2_ORG2_OPS_PORT=9456
PEER0_ORG3_OPS_PORT=9457
PEER1_ORG3_OPS_PORT=9458
PEER2_ORG3_OPS_PORT=9459

# ------------------------------------------------------------------ ports: CouchDB
COUCHDB0_PORT=5984
COUCHDB1_PORT=5985
COUCHDB2_PORT=5986
COUCHDB3_PORT=5987
COUCHDB4_PORT=5988
COUCHDB5_PORT=5989
COUCHDB6_PORT=5990
COUCHDB7_PORT=5991
COUCHDB8_PORT=5992

COUCHDB_USER=admin
COUCHDB_PASSWORD=adminpw

# ------------------------------------------------------------------ misc
FABRIC_LOGGING_SPEC=INFO
